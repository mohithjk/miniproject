# Environment variables for AI Project Coordinator

# Application settings
PROJECT_NAME="AI Project Coordinator"
ENVIRONMENT=development
DEBUG=True

# Database connection (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/ai_coordinator

# Security & Tokens
SECRET_KEY=supersecretjwtkey_must_be_changed_in_prod_at_least_32_bytes
FERNET_KEY=gH8K6P89YxZ3L1T2W7V5bN0M4Q6R8T1U2I3O4P5A6B7=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Webhook ingress base URL (used when registering GitHub webhooks)
WEBHOOK_BASE_URL=http://localhost:8000

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Completion Scoring Thresholds (Core Rule 4)
SCORE_PR_MERGED=0.5
SCORE_CI_PASSED=0.2
SCORE_FILES_EXIST=0.15
SCORE_JUDGE_WEIGHT=0.15
AUTO_COMPLETE_THRESHOLD=0.8
CONFIRM_THRESHOLD=0.5

# Job Worker Settings (Core Rule 5)
MAX_JOB_ATTEMPTS=3
JOB_POLL_INTERVAL_SECONDS=2.0

# Optional Outbound Chat Webhooks (Discord & Slack notifications)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
